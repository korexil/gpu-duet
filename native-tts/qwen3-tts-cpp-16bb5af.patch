diff --git a/src/common/utf8_path.h b/src/common/utf8_path.h
new file mode 100644
index 0000000..dae5482
--- /dev/null
+++ b/src/common/utf8_path.h
@@ -0,0 +1,52 @@
+#pragma once
+
+#include <cstdio>
+#include <filesystem>
+#include <string>
+
+#ifdef _WIN32
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+#endif
+
+namespace qwen3_tts {
+
+// Paths arrive as UTF-8 (from the CLI's UTF-8 argv and from the C bridge). On Windows the
+// narrow fopen / std::filesystem constructors read them in the ANSI code page instead, so a
+// Japanese or Chinese directory name opens the wrong file. Convert to wide first.
+#ifdef _WIN32
+inline std::wstring utf8_to_wide(const std::string & utf8) {
+    if (utf8.empty()) {
+        return std::wstring();
+    }
+    const int length = MultiByteToWideChar(CP_UTF8, 0, utf8.data(), (int) utf8.size(), nullptr, 0);
+    std::wstring wide(length > 0 ? (size_t) length : 0, L'\0');
+    if (length > 0) {
+        MultiByteToWideChar(CP_UTF8, 0, utf8.data(), (int) utf8.size(), &wide[0], length);
+    }
+    return wide;
+}
+
+inline std::filesystem::path utf8_fs_path(const std::string & utf8) {
+    return std::filesystem::path(utf8_to_wide(utf8));
+}
+
+inline FILE * utf8_fopen(const std::string & utf8, const char * mode) {
+    return _wfopen(utf8_to_wide(utf8).c_str(), utf8_to_wide(mode).c_str());
+}
+#else
+inline std::filesystem::path utf8_fs_path(const std::string & utf8) {
+    return std::filesystem::path(utf8);
+}
+
+inline FILE * utf8_fopen(const std::string & utf8, const char * mode) {
+    return fopen(utf8.c_str(), mode);
+}
+#endif
+
+} // namespace qwen3_tts
diff --git a/src/env_flag.h b/src/env_flag.h
new file mode 100644
index 0000000..015f29c
--- /dev/null
+++ b/src/env_flag.h
@@ -0,0 +1,28 @@
+#pragma once
+
+#include <cctype>
+#include <cstdlib>
+#include <cstring>
+
+namespace qwen3_tts {
+
+// One rule for every QWEN3_TTS_* switch: "1", "true", "on" or "yes" (any case) turn it
+// on; unset, empty, "0", "false", "off", "no" and anything else leave it off.
+inline bool env_flag_on(const char * key) {
+    const char * value = std::getenv(key);
+    if (!value || !*value) {
+        return false;
+    }
+    char lowered[8] = {0};
+    const size_t length = std::strlen(value);
+    if (length >= sizeof(lowered)) {
+        return false;
+    }
+    for (size_t i = 0; i < length; ++i) {
+        lowered[i] = (char) std::tolower((unsigned char) value[i]);
+    }
+    return !std::strcmp(lowered, "1") || !std::strcmp(lowered, "true") ||
+           !std::strcmp(lowered, "on") || !std::strcmp(lowered, "yes");
+}
+
+} // namespace qwen3_tts
