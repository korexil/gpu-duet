+template <typename Body>
+static int32_t guarded_status(qwen3_tts_context_t* ctx, Body && body) {
+    try {
+        return body();
+    } catch (const std::exception & error) {
+        set_last_error(ctx, error.what());
+        return 0;
+    } catch (...) {
+        set_last_error(ctx, UNKNOWN_EXCEPTION);
+        return 0;
+    }
+}
