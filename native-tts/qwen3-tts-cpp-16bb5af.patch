+template <typename Body>
+static qwen3_tts_result_t guarded_result(Body && body) {
+    try {
+        return body();
+    } catch (const std::exception & error) {
+        return make_error_result(error.what());
+    } catch (...) {
+        return make_error_result(UNKNOWN_EXCEPTION);
+    }
